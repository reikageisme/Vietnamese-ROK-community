enum UploadPurpose {
  PROFILE_SCREENSHOT
  SCAN_EVIDENCE
  FORUM_ATTACHMENT
  CODEX_EVIDENCE
  ALLIANCE_CSV
}

enum IngestionStatus {
  QUEUED
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum SubmissionEntityType {
  COMMANDER
  EQUIPMENT
  TALENT
  CIVILIZATION
  TROOP
  EVENT
  GOVERNOR_PROFILE
}

enum ModerationDecision {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

enum ScanProduct {
  KINGDOM_OVERVIEW
  GOVERNOR_TOP_300
  KVK_CAMP
}

enum ScanServiceStatus {
  QUEUED
  ASSIGNED
  RUNNING
  REVIEWING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreditTransactionKind {
  TOP_UP
  SCAN_CHARGE
  REFUND
  ADMIN_ADJUSTMENT
}

model CreditWallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Int                 @default(0)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model CreditTransaction {
  id           String                @id @default(cuid())
  walletId     String
  actorId      String?
  kind         CreditTransactionKind
  amount       Int
  balanceAfter Int
  reference    String?               @db.VarChar(191)
  note         String?               @db.Text
  wallet       CreditWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  actor        User?                 @relation("CreditTransactionActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())

  @@index([walletId, createdAt])
  @@index([reference])
}

model ScanServiceRequest {
  id               String            @id @default(cuid())
  requestCode      String            @unique @db.VarChar(32)
  requesterId      String
  kingdomNumber    Int
  product          ScanProduct
  costCredits      Int
  status           ScanServiceStatus @default(QUEUED)
  note             String?           @db.Text
  assignedDeviceId String?           @db.VarChar(100)
  collectorBatchId String?
  requester        User              @relation("ScanRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  collectorBatch   CollectorBatch?   @relation(fields: [collectorBatchId], references: [id], onDelete: SetNull)
  automationJob    AutomationJob?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  completedAt      DateTime?

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([kingdomNumber, createdAt])
}

model TopUpRequest {
  id                String      @id @default(cuid())
  requesterId       String
  reviewerId        String?
  amountVnd         Int
  credits           Int
  transferReference String      @db.VarChar(100)
  status            TopUpStatus @default(PENDING)
  reviewerNote      String?     @db.Text
  requester         User        @relation("TopUpRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewer          User?       @relation("TopUpReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  reviewedAt        DateTime?

  @@unique([requesterId, transferReference])
  @@index([requesterId, createdAt])
  @@index([status, createdAt])
}

model UploadAsset {
  id               String             @id @default(cuid())
  ownerId          String
  purpose          UploadPurpose
  objectKey        String             @unique @db.VarChar(512)
  mimeType         String             @db.VarChar(100)
  byteSize         Int
  sha256           String             @db.Char(64)
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ocrJob           OcrJob?
  snapshotEvidence GovernorSnapshot[]
  csvImport        CsvImportJob?
  createdAt        DateTime           @default(now())

  @@index([ownerId, createdAt])
}

model OcrJob {
  id                String             @id @default(cuid())
  uploadId          String             @unique
  governorProfileId String
  status            IngestionStatus    @default(QUEUED)
  result            Json?
  confidence        Json?
  errorCode         String?            @db.VarChar(100)
  upload            UploadAsset        @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  governorProfile   GovernorProfile    @relation(fields: [governorProfileId], references: [id], onDelete: Restrict)
  reviews           ModerationReview[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt])
}

model IngestionSubmission {
  id          String               @id @default(cuid())
  submitterId String
  entityType  SubmissionEntityType
  entityId    String?
  payload     Json
  sourceNote  String               @db.Text
  status      IngestionStatus      @default(PENDING_REVIEW)
  submitter   User                 @relation(fields: [submitterId], references: [id], onDelete: Restrict)
  reviews     ModerationReview[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([submitterId])
}

model ModerationReview {
  id           String               @id @default(cuid())
  moderatorId  String
  submissionId String?
  ocrJobId     String?
  decision     ModerationDecision
  note         String?              @db.Text
  moderator    User                 @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  submission   IngestionSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ocrJob       OcrJob?              @relation(fields: [ocrJobId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())

  // Application validation enforces exactly one of submissionId/ocrJobId.
  @@index([moderatorId, createdAt])
}

model CsvImportJob {
  id         String          @id @default(cuid())
  ownerId    String
  allianceId String
  uploadId   String          @unique
  status     IngestionStatus @default(QUEUED)
  summary    Json?
  errorCode  String?         @db.VarChar(100)
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  alliance   Alliance        @relation(fields: [allianceId], references: [id], onDelete: Restrict)
  upload     UploadAsset     @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([allianceId])
}

model CollectorBatch {
  id                 String               @id @default(cuid())
  externalId         String               @unique @db.VarChar(191)
  deviceId           String               @db.VarChar(100)
  kingdomId          String
  status             IngestionStatus      @default(PENDING_REVIEW)
  recordCount        Int
  evidenceObjectKeys Json?
  payloadHash        String               @db.Char(64)
  summary            Json?
  errorCode          String?              @db.VarChar(100)
  capturedAt         DateTime
  kingdom            Kingdom              @relation(fields: [kingdomId], references: [id], onDelete: Restrict)
  governorSnapshots  GovernorSnapshot[]
  kingdomSnapshot    KingdomSnapshot?
  serviceRequests    ScanServiceRequest[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([kingdomId, capturedAt])
  @@index([status, createdAt])
  @@index([deviceId, createdAt])
}
