# Sao chép thành .env rồi sửa. Không commit file .env.

# Bắt buộc: token truy cập panel. Sinh bằng: openssl rand -hex 24
PANEL_TOKEN=thay-bang-token-ngau-nhien-48-ky-tu

# Cổng panel trong container. Host chỉ bind 127.0.0.1 (xem docker-compose.yml).
PANEL_PORT=5100

# Package game. Bản Việt Nam là com.rok.gp.vn.
GAME_PACKAGE=com.rok.gp.vn

# Nhịp chụp. Giữ thưa để không cướp băng thông USB của scanner.
# 16 máy x ~2MB moi anh: 5 giay/anh ~ 6,4 MB/s, an toan tren USB 2.0.
GRID_INTERVAL_SECONDS=5
FOCUS_INTERVAL_SECONDS=0.8
CAPTURE_WORKERS=3
SLOW_CAPTURE_SECONDS=3

# Kích thước ảnh gửi về trình duyệt.
GRID_WIDTH=420
FOCUS_WIDTH=1280
JPEG_QUALITY=72

# Chế độ đồng bộ. Đặt false để khoá cứng, không ai bật được từ giao diện.
BROADCAST_ENABLED=true
BROADCAST_MAX_DEVICES=32
