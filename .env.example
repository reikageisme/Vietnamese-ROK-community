# Copy this file to .env for local development. Replace every production value.
NODE_ENV=development
# APP_URL va NEXTAUTH_URL PHAI khop dung dia chi nguoi dung go tren trinh duyet.
# Lech mot chu la Google OAuth tra ve sai callback va link trong email dan di dau mat.
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=dev-only-change-before-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Mailpit defaults are used by local Docker development)
# Chi SMTP_HOST la bat buoc o production. USER/PASSWORD de trong cung duoc —
# relay noi bo hoac may chu mail trong LAN thuong khong xac thuc, va email.ts
# tu bo phan auth khi SMTP_USER rong.
#
# Nhanh nhat de co mail that: Gmail App Password (can bat 2FA truoc)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=dia-chi@gmail.com
#   SMTP_PASSWORD=<app password 16 ky tu, KHONG phai mat khau Gmail>
#   EMAIL_FROM=ROK FAQ <dia-chi@gmail.com>
# Gmail bat buoc EMAIL_FROM trung SMTP_USER, va gioi han vai tram thu moi ngay.
# Khi co ten mien rokfaq.com nen chuyen sang dich vu gui thu chuyen dung.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ROK FAQ <no-reply@rokfaq.local>

# PostgreSQL
# Bon dong duoi va S3_BUCKET giu nguyen chu 'rokviet': chung la ten database,
# role va bucket CO THAT dang chua du lieu. Thuong hieu la ROK FAQ, con day la
# khoa ky thuat — doi la mat du lieu, khong phai doi nhan.
# Postgres chay o may khac (vi du mot container rieng)? Dat true.
# Khi do update-web.sh nap them compose.external-db.yml de KHONG dung
# container Postgres noi bo, va DATABASE_URL phai tro toi may that.
EXTERNAL_DB=false

POSTGRES_DB=rokviet
POSTGRES_USER=rokviet
POSTGRES_PASSWORD=rokviet_dev_password
DATABASE_URL=postgresql://rokviet:rokviet_dev_password@postgres:5432/rokviet?schema=public

# Redis / queues
REDIS_URL=redis://redis:6379/0
OCR_QUEUE_KEY=rokfaq:ocr:jobs
OCR_RESULT_TTL_SECONDS=604800
OCR_MAX_IMAGE_BYTES=15728640
OCR_MAX_IMAGE_PIXELS=25000000

# S3-compatible object storage (MinIO locally)
MINIO_ROOT_USER=rokfaq
MINIO_ROOT_PASSWORD=rokviet_dev_minio_password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rokfaq
S3_SECRET_ACCESS_KEY=rokviet_dev_minio_password
S3_BUCKET=rokviet-uploads
S3_FORCE_PATH_STYLE=true

# Dia chi Caddy phuc vu.
#   :80          -> HTTP thuan tren cong 80 cho moi hostname, KHONG xin chung chi.
#                   Dung khi chua co ten mien, hoac khi dung sau Cloudflare Tunnel.
#   rokfaq.com   -> Caddy tu lay chung chi Let's Encrypt. Chi duoc khi cong 80 va
#                   443 thong tu Internet toi may nay.
DOMAIN=:80
WEB_REPLICAS=1

# Da co reverse proxy khac dung truoc (Nginx Proxy Manager, Cloudflare Tunnel)?
# Dat true de KHONG chay Caddy — hai proxy cung gianh cong 80 thi cai thu hai
# khong len duoc.
EXTERNAL_PROXY=false

# Cong web lang nghe tren may nay.
#   Co Caddy dung truoc  -> giu 127.0.0.1, cong nay chi de go loi.
#   Co proxy ngoai       -> dat WEB_BIND_ADDRESS=0.0.0.0 va tro proxy vao cong nay.
WEB_PORT=3030
WEB_BIND_ADDRESS=127.0.0.1
# Private Ops Console. Keep 127.0.0.1 and use an SSH tunnel or protected reverse proxy.
OPS_BIND_ADDRESS=127.0.0.1
OPS_PORT=3031
OPS_APP_URL=http://localhost:3031
# Collector API (generate a random value of at least 24 characters)
COLLECTOR_API_TOKEN=replace-with-a-long-random-token
# Token cho agent Windows/Proxmox gọi riêng cổng Ops (tối thiểu 32 ký tự)
DEVICE_AGENT_TOKEN=replace-with-a-separate-32-character-agent-token
# Tắt mặc định: không hiện dịch vụ/hàng đợi cập nhật dữ liệu trên web công khai.
PUBLIC_DATA_REQUESTS=false

# Demo accounts are opt-in. Never enable predictable demo passwords on a public host.
SEED_DEMO_ACCOUNTS=false
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
DEMO_MEMBER_PASSWORD=RokFaqDemo!2026
DEMO_MODERATOR_PASSWORD=RokFaqMod!2026

# --- Cong thanh toan VNPay ---
# Thieu bat ky bien nao la coi nhu chua bat: nut thanh toan tra ve 503 thay vi
# doan gia tri mac dinh cho thu lien quan toi tien.
# Sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# That:    https://vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://rokfaq.com/api/scan-service/vnpay-return
