{
	admin 0.0.0.0:2019
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy web:3000 {
		health_uri /
		health_interval 15s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}
